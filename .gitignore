# ==============================================================================
# .gitignore for 8-bit Multiplier Project (AMD Vivado & Nangate 45nm ASIC)
# ==============================================================================

# Build & Synthesis Output Directories
build/
reports/
bitstream/

# Bitstream & Programming Files
*.bit
*.bin
*.mcs
*.prm
*.bgn
*.drc
*.fs

# EDA & Simulation Reports
*.rpt
reports/*
bitstream/*.rpt

# Vivado / EDA Temporary Files, Checkpoints & WebTalk Logs
.Xil/
.xil/
hd_visual/
vivado/*.cache/
vivado/*.hw/
vivado/*.ip_user_files/
vivado/*.runs/
vivado/*.sim/
*.jou
*.log
*.str
*.pb
*.dcp
*.wdb
*.vcd
clockInfo.txt
webtalk*
usage_statistics_webtalk.*
command.txt

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# OS & Editor Metadata
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.vscode/
.idea/
